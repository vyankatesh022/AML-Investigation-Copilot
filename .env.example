# Environment Configuration for FinGuard AI
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Keys (Optional in Session 2; Required for LangGraph/LLM in Session 6)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Compliance Rule Thresholds
HIGH_VALUE_THRESHOLD=10000.0
STRUCTURING_LOWER_BOUND=9000.0
STRUCTURING_UPPER_BOUND=9999.99
RAPID_DRAIN_RATIO=0.90
